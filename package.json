{
  "name": "saas-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present && prettier --write \"README.md\" \"docs/**/*.md\" \".github/**/*.md\" \".github/**/*.yml\"",
    "format:check": "npm run format:check --workspaces --if-present && prettier --check \"README.md\" \"docs/**/*.md\" \".github/**/*.md\" \".github/**/*.yml\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "apps/web/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config apps/web/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "apps/api/**/*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --config apps/api/eslint.config.mjs --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml,css}": "prettier --write"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "body-parser": "2.4.0"
  }
}
