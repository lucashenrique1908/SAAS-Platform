# Configure estas variáveis com os mesmos parâmetros do serviço PostgreSQL em compose.yaml.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=defina_uma_senha_local
POSTGRES_DB=saas_db
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
EMAIL_FROM=SaaS Platform <onboarding@resend.dev>
# Configure a Resend API key and a verified sender domain before sending real email.
RESEND_API_KEY=
# Server-side URL used by the Next.js BFF to reach the API.
API_BASE_URL=http://localhost:3001
# Local private-file storage. Production must configure and harden its storage adapter.
DEVELOPER_UPLOAD_DIR=./var/developer-uploads
# Configure a 32-byte base64/hex key before enabling external-provider integrations.
DEVELOPER_TOKEN_ENCRYPTION_KEY=
API_PUBLIC_BASE_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Production listings require a commercial licence and official attribution setup.
ADZUNA_COMMERCIAL_LICENSE_CONFIRMED=false
ADZUNA_ATTRIBUTION_LOGO_URL=
